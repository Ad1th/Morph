/* Morph TUI -- abyss / rose ground, gold evidence accent (see theme.py).
   One panel language: round Textual borders with CAPS border-titles.
   Breakpoints (set on Screen by the app): -compact (< 120 cols) / -wide,
   -short (< 36 rows) / -tall. */

Screen {
    background: $background;
    color: $bone;
}

/* ---------- shared chrome ---------- */

.screen-title {
    dock: top;
    height: 1;
    background: $surface;
    color: $rose-soft;
    padding: 0 1;
}

.screen-title.flash {
    background: $fail;
    color: $ink-on-fail;
}

.status-bar {
    height: 1;
    width: 100%;
    background: $surface;
    color: $bone-dim;
}

.status-left {
    width: 1fr;
    height: 1;
}

.status-right {
    width: auto;
    height: 1;
    text-align: right;
}

#status-progress {
    width: 14;
    height: 1;
    margin: 0 1 0 0;
}

#status-progress Bar {
    width: 1fr;
}

#status-progress Bar > .bar--bar {
    color: $evidence;
    background: $track;
}

#status-progress Bar > .bar--complete {
    color: $pass;
}

Footer {
    background: $surface;
}

Footer > .footer-key--key, FooterKey .footer-key--key {
    color: $evidence;
    background: $surface;
}

FooterKey .footer-key--description {
    color: $bone-dim;
}

.hidden {
    display: none;
}

/* setup bars: compact widgets, one or two rows */
.setup {
    height: auto;
    padding: 0 1;
    background: $surface;
}

.setup .row {
    height: 1;
    margin-bottom: 0;
}

.setup Label {
    color: $bone-dim;
    padding: 0 1 0 0;
    width: auto;
}

.setup Input {
    width: 1fr;
    background: $panel;
    color: $bone;
    margin-right: 1;
}

.setup Input:focus {
    background: $boost;
}

.setup Input.narrow {
    width: 7;
}

.setup Input.mid {
    width: 14;
}

.setup Button {
    margin-right: 1;
    min-width: 8;
    color: $bone;
}

.setup Button.-primary {
    background: $fail;
    color: $ink-on-fail;
    text-style: bold;
}

.setup Button.-success {
    background: $pass;
    color: $ink-on-pass;
    text-style: bold;
}

.setup Button:disabled {
    background: $panel;
    color: $bone-dim;
}

.setup Checkbox {
    background: $surface;
    color: $bone;
    margin-right: 1;
    width: auto;
}

.setup Checkbox > .toggle--button {
    color: $evidence;
    background: $panel;
}

.setup Select {
    width: 26;
    margin-right: 1;
}

.setup Select > SelectCurrent {
    background: $panel;
    border: none;
    height: 1;
    padding: 0 1;
}

/* every panel shares one border language */
.panel {
    border: round $evidence-dim;
    border-title-color: $evidence;
    border-title-style: bold;
    border-subtitle-color: $bone-dim;
    padding: 0 1;
}

RichLog.panel {
    background: $surface;
    color: $bone;
    scrollbar-color: $evidence-dim;
    scrollbar-background: $surface;
}

DataTable {
    background: $background;
    color: $bone;
    border: round $evidence-dim;
    border-title-color: $evidence;
    border-title-style: bold;
}

DataTable > .datatable--header {
    background: $surface;
    color: $bone-dim;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $panel;
    color: $bone;
}

DataTable > .datatable--even-row {
    background: $surface 40%;
}

/* ---------- Home ---------- */

#home-wrap {
    align: center top;
    height: 1fr;
    padding: 1 2 0 2;
}

#logo {
    color: $fail;
    text-style: bold;
    content-align: center middle;
    text-align: center;
    width: 100%;
    height: auto;
    margin-bottom: 0;
}

#wordmark {
    color: $fail;
    text-style: bold;
    content-align: center middle;
    text-align: center;
    width: 100%;
    height: 1;
}

Screen.-tall #wordmark { display: none; }
Screen.-short #logo { display: none; }

#tagline {
    color: $bone-dim;
    content-align: center middle;
    text-align: center;
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

#menu {
    grid-size: 2 3;
    grid-gutter: 0 2;
    grid-rows: 4;
    grid-columns: 1fr;
    width: 100%;
    height: auto;
    max-width: 80;
}

Screen.-wide #menu {
    grid-size: 3 2;
    max-width: 120;
}

.card {
    width: 100%;
    min-width: 30;
    height: 4;
    border: round $evidence-dim;
    background: $surface;
    color: $bone;
    content-align: center middle;
    text-align: center;
    text-style: none;
}

.card:hover {
    border: round $evidence;
    background: $panel;
}

.card:focus {
    border: round $fail;
    background: $panel;
    text-style: bold;
}

#home-status {
    height: 1;
    padding: 0 1;
    color: $bone-dim;
    text-align: center;
    width: 100%;
    margin-top: 1;
}

/* ---------- Experiment ---------- */

#exp-body {
    height: 1fr;
}

#exp-left {
    width: 3fr;
    height: 1fr;
    padding: 0 1;
    scrollbar-color: $evidence-dim;
    scrollbar-background: $background;
}

#exp-right {
    width: 2fr;
    height: 1fr;
    min-width: 30;
}

Screen.-compact #exp-body {
    layout: vertical;
}

Screen.-compact #exp-left {
    width: 100%;
    height: 1fr;
    min-height: 8;
}

Screen.-compact #exp-right {
    width: 100%;
    height: 9;
}

#lanes {
    height: auto;
}

.lane {
    height: auto;
    border-top: round $evidence-dim;
    border-title-color: $rose-soft;
    border-title-style: bold;
    padding: 0 1;
}

.lane.decisive {
    border-top: round $evidence;
    border-title-color: $evidence;
}

#lanes-empty {
    color: $bone-dim;
    padding: 1 1;
    height: auto;
}

#verdict, #matrix {
    height: auto;
    margin-top: 1;
}

#matrix {
    width: auto;
}

#evidence {
    height: auto;
    max-height: 45%;
    background: $surface;
}

Screen.-compact #evidence {
    max-height: 4;
}

#exp-log {
    height: 1fr;
}

/* ---------- Environment ---------- */

#env-diff {
    height: 1fr;
    margin: 0 1;
}

#env-edit {
    height: 1;
    padding: 0 1;
    background: $surface;
}

#env-edit-label {
    width: auto;
    color: $bone-dim;
    padding: 0 1 0 0;
}

#env-edit-input {
    width: 1fr;
    background: $panel;
}

/* ---------- Threshold ---------- */

#th-body {
    height: 1fr;
}

#th-gauge-wrap {
    height: auto;
}

.gauge {
    height: auto;
    margin: 0 1;
}

#th-empty {
    color: $bone-dim;
    padding: 1 2;
    height: auto;
}

#th-log {
    height: 1fr;
    margin: 0 1;
}

/* ---------- Regressions ---------- */

#reg-table {
    height: 1fr;
    min-height: 5;
    margin: 0 1;
}

#reg-lane-wrap {
    height: auto;
    margin: 0 1;
}

#reg-verdict {
    height: auto;
    margin: 0 1;
}

#reg-log {
    height: 6;
    margin: 0 1;
}

Screen.-compact #reg-log {
    height: 4;
}

/* ---------- Monitor ---------- */

#mon-body {
    height: 1fr;
}

#mon-sliders {
    width: 1fr;
    min-width: 46;
    height: 1fr;
    padding: 0 1;
    border: round $evidence-dim;
    border-title-color: $evidence;
    border-title-style: bold;
    margin: 0 1;
}

#mon-graph {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    scrollbar-size: 1 1;
    scrollbar-color: $evidence-dim;
    scrollbar-background: $background;
    border: round $evidence-dim;
    border-title-color: $evidence;
    border-title-style: bold;
    margin: 0 1 0 0;
}

Screen.-compact #mon-body {
    layout: vertical;
}

Screen.-compact #mon-sliders {
    width: 100%;
    height: 9;
    margin: 0 1;
}

Screen.-compact #mon-graph {
    width: 100%;
    height: 1fr;
    margin: 0 1;
}

.slider {
    height: 1;
    color: $bone;
}

.slider:focus {
    background: $panel;
}

.slider.warn {
    color: $fail;
}

.mon-metric {
    color: $bone-dim;
    height: 1;
}

#mon-graph Sparkline {
    height: 2;
    margin-bottom: 0;
}

Screen.-short #mon-graph Sparkline {
    height: 1;
}

Screen.-tall #mon-graph Sparkline {
    height: 3;
}

#mon-graph Sparkline > .sparkline--max-color {
    color: $fail;
}

#mon-graph Sparkline > .sparkline--min-color {
    color: $evidence-dim;
}

.mon-val {
    text-style: bold;
    color: $bone;
    height: 1;
}

#mon-strip {
    color: $bone-dim;
    height: auto;
}

#mon-warn {
    height: auto;
    min-height: 1;
    max-height: 3;
    padding: 0 1;
    margin: 0 1;
    background: $surface;
    color: $bone;
}

/* ---------- Projects ---------- */

#proj-table {
    height: 1fr;
    min-height: 4;
    margin: 0 1;
}

#proj-log {
    height: 6;
    margin: 0 1;
}

Screen.-compact #proj-log {
    height: 4;
}

/* ---------- Help modal ---------- */

HelpScreen {
    align: center middle;
}

#help-box {
    width: 64;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    border: round $evidence;
    border-title-color: $evidence;
    border-title-style: bold;
    border-subtitle-color: $bone-dim;
    background: $surface;
    padding: 0 2;
}

#help-body {
    height: auto;
}

/* ---------- command palette ---------- */

CommandPalette > Vertical {
    background: $surface;
    border: round $evidence;
}

CommandPalette #--input {
    background: $panel;
}
