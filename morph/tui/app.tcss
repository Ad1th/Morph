/* Morph TUI -- one restrained accent ($accent), dark-first, adapts to light. */

Screen {
    background: $background;
}

/* ---------- Home ---------- */

#home-wrap {
    align: center middle;
    height: 1fr;
}

#logo {
    color: $accent;
    text-style: bold;
    content-align: center middle;
    width: auto;
    margin-bottom: 1;
}

#tagline {
    color: $text-muted;
    content-align: center middle;
    width: 100%;
    margin-bottom: 2;
}

#menu {
    grid-size: 2 2;
    grid-gutter: 1 2;
    grid-rows: 5;
    grid-columns: 32;
    width: auto;
    height: auto;
}

.card {
    width: 32;
    height: 5;
    border: round $panel-lighten-2;
    background: $panel;
    color: $text;
    content-align: center middle;
    text-align: center;
}

.card:hover {
    border: round $accent;
    background: $boost;
}

.card:focus {
    border: thick $accent;
    background: $boost;
}

#home-status {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

/* ---------- shared screen chrome ---------- */

.screen-title {
    dock: top;
    height: 1;
    background: $accent;
    color: $text;
    text-style: bold;
    padding: 0 1;
}

.placeholder {
    align: center middle;
    height: 1fr;
    color: $text-muted;
}

.hidden {
    display: none;
}

/* ---------- Experiment ---------- */

#setup {
    height: auto;
    padding: 1;
    background: $panel;
    align-vertical: middle;
}

#setup Label {
    padding: 1 1 0 2;
    color: $text-muted;
}

#setup Input {
    width: 1fr;
}

#setup #in-trials {
    width: 8;
}

#setup #btn-run {
    margin-left: 2;
}

#exp-body {
    height: 1fr;
}

#lanes {
    width: 3fr;
    padding: 1 2;
}

.lane {
    height: auto;
    padding: 1 0;
    border-bottom: dashed $panel-lighten-2;
}

#exp-log {
    width: 2fr;
    border-left: solid $panel-lighten-2;
    padding: 0 1;
    background: $surface;
}

#verdict {
    height: auto;
    padding: 0 2 1 2;
}

ExperimentScreen.significant {
    border: thick $error;
}
