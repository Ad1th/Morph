/* Morph TUI -- one restrained accent ($accent), dark-first, adapts to light. */

Screen {
    background: $background;
}

/* ---------- Home ---------- */

#home-wrap {
    align: center middle;
    height: 1fr;
}

#logo {
    color: $accent;
    text-style: bold;
    content-align: center middle;
    width: auto;
    margin-bottom: 1;
}

#tagline {
    color: $text-muted;
    content-align: center middle;
    width: 100%;
    margin-bottom: 2;
}

#menu {
    grid-size: 2 3;
    grid-gutter: 1 2;
    grid-rows: 5;
    grid-columns: 32;
    width: auto;
    height: auto;
}

.card {
    width: 32;
    height: 5;
    border: round $panel-lighten-2;
    background: $panel;
    color: $text;
    content-align: center middle;
    text-align: center;
}

.card:hover {
    border: round $accent;
    background: $boost;
}

.card:focus {
    border: thick $accent;
    background: $boost;
}

#home-status {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

/* ---------- shared screen chrome ---------- */

.screen-title {
    dock: top;
    height: 1;
    background: $accent;
    color: $text;
    text-style: bold;
    padding: 0 1;
}

.placeholder {
    align: center middle;
    height: 1fr;
    color: $text-muted;
}

.hidden {
    display: none;
}

/* ---------- Experiment ---------- */

#setup {
    height: auto;
    padding: 1;
    background: $panel;
    align-vertical: middle;
}

#setup Label {
    padding: 1 1 0 2;
    color: $text-muted;
}

#setup Input {
    width: 1fr;
}

#setup #in-trials {
    width: 8;
}

#setup #in-regid {
    width: 16;
}

#setup #btn-run {
    margin-left: 2;
}

#setup #btn-save {
    margin-left: 1;
}

#exp-body {
    height: 1fr;
}

#lanes {
    width: 3fr;
    padding: 1 2;
}

.lane {
    height: auto;
    padding: 1 0;
    border-bottom: dashed $panel-lighten-2;
}

#exp-log {
    width: 2fr;
    border-left: solid $panel-lighten-2;
    padding: 0 1;
    background: $surface;
}

#verdict, #matrix {
    height: auto;
    padding: 0 2 1 2;
}

ExperimentScreen.significant {
    border: thick $error;
}

/* ---------- Environment ---------- */

#env-bar {
    height: auto;
    padding: 1;
    background: $panel;
}

#env-bar Select {
    width: 24;
}

#env-bar Input {
    width: 1fr;
    margin-left: 1;
}

#env-bar Button {
    margin-left: 1;
}

#env-diff {
    height: 1fr;
    margin: 1 2;
}

#env-edit {
    height: auto;
    padding: 0 2;
}

#env-edit-label {
    width: 22;
    color: $text-muted;
    padding: 1 1 0 0;
}

#env-edit-input {
    width: 1fr;
}

#env-status {
    dock: bottom;
    height: 1;
    padding: 0 2;
    background: $panel;
    color: $text-muted;
}

/* ---------- Threshold ---------- */

#th-bar, #th-setup2 {
    height: auto;
    padding: 1 1 0 1;
    background: $panel;
}

#th-setup2 {
    padding: 0 1 1 1;
}

#th-bar Select {
    width: 28;
}

#th-bar Input {
    width: 12;
    margin-left: 1;
}

#th-bar Button {
    margin-left: 2;
}

#th-setup2 Input {
    width: 1fr;
    margin-right: 1;
}

#th-gauge-wrap {
    height: auto;
    padding: 1 2;
}

.gauge {
    height: auto;
    padding: 1 0;
}

#th-log {
    height: 1fr;
    border-top: solid $panel-lighten-2;
    padding: 0 2;
    background: $surface;
}

/* ---------- Regressions ---------- */

#reg-table {
    height: 1fr;
    margin: 0 2;
}

#reg-bar {
    height: auto;
    padding: 1;
    background: $panel;
}

#reg-bar Input {
    width: 10;
}

#reg-bar Button {
    margin-left: 2;
}

#reg-log {
    height: 8;
    border-top: solid $panel-lighten-2;
    padding: 0 2;
    background: $surface;
}

#reg-status {
    dock: bottom;
    height: 1;
    padding: 0 2;
    background: $panel;
    color: $text-muted;
}

RegressionsScreen .lane {
    padding: 0 2;
}

/* ---------- Monitor ---------- */

#mon-bar {
    height: auto;
    padding: 1;
    background: $panel;
    align-vertical: middle;
}

#mon-bar #mon-command {
    width: 1fr;
}

#mon-bar Label {
    padding: 0 1 0 2;
    color: $text-muted;
}

#mon-bar #mon-run {
    margin-left: 2;
}

#mon-body {
    height: 1fr;
}

#mon-sliders {
    width: 2fr;
    padding: 1 2;
}

.slider {
    height: 1;
    color: $text;
}

.slider:focus {
    background: $boost;
}

#mon-graph {
    width: 3fr;
    padding: 1 2;
    border-left: solid $panel-lighten-2;
    background: $surface;
}

.mon-h {
    color: $text-muted;
    text-style: bold;
    margin-bottom: 1;
}

.mon-metric {
    color: $text-muted;
    margin-top: 1;
}

#mon-graph Sparkline {
    height: 3;
}

.mon-val {
    text-style: bold;
}

#mon-strip {
    color: $text-muted;
}

#mon-warn {
    dock: bottom;
    height: auto;
    min-height: 1;
    padding: 0 2;
    background: $panel;
    color: $text;
}

/* ---------- Projects ---------- */

#proj-bar {
    height: auto;
    padding: 1;
    background: $panel;
    align-vertical: middle;
}

#proj-bar #proj-src {
    width: 1fr;
}

#proj-bar Checkbox {
    margin: 0 1;
}

#proj-bar #proj-connect {
    margin-left: 1;
}

#proj-table {
    height: 1fr;
    margin: 0 2;
}

#proj-actions {
    height: auto;
    padding: 1;
    background: $panel;
}

#proj-actions Button {
    margin-right: 1;
}

#proj-log {
    height: 8;
    border-top: solid $panel-lighten-2;
    padding: 0 2;
    background: $surface;
}

#proj-status {
    dock: bottom;
    height: 1;
    padding: 0 2;
    background: $panel;
    color: $text-muted;
}
