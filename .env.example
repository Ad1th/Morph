# Morph environment. Copy to `.env` (gitignored) and fill in what you need.
# `morph` loads the nearest .env at startup (CLI, `morph serve`, `morph tui`).
# Everything here is OPTIONAL: Morph runs fully local with none of it set.
# Non-secret project settings belong in morph.yaml (committed), not here.

# ---- GitHub ---------------------------------------------------------------
# Public client id of a GitHub OAuth App with "Enable Device Flow" ticked.
# Enables "Connect through GitHub" (a page opens, you type a code) in the
# dashboard. Not a secret; may also live under github.client_id in morph.yaml.
GITHUB_CLIENT_ID=

# A personal access token, if you would rather not sign in interactively.
# Read in this order: MORPH_GITHUB_TOKEN, GITHUB_TOKEN, GH_TOKEN, `gh auth token`.
MORPH_GITHUB_TOKEN=

# ---- Remote worker (explicit `morph run --cloud`) -------------------------
# Any SSH box with Morph installed: a Raspberry Pi, a GCP instance, a laptop.
# Host/user/key are read from here so morph.yaml can be committed without them.
MORPH_CLOUD_HOST=
MORPH_CLOUD_USER=
MORPH_CLOUD_SSH_KEY=

# ---- `morph serve` --------------------------------------------------------
# The API executes commands on the machine it runs on. It binds 127.0.0.1 by
# default; only expose it on a private network or behind an authenticating
# reverse proxy. When the dashboard is served from another origin, list it:
MORPH_EXTRA_ORIGINS=
# Comma-separated hostnames the server may be addressed as (TrustedHost):
MORPH_ALLOWED_HOSTS=
MORPH_SERVE_PORT=8000

# ---- Reproducibility and CI -----------------------------------------------
# Seed for the proxy's loss pattern and trial ordering (also exported to the app).
MORPH_SEED=
# Never touch the network or native shaping (set in CI and in tests).
MORPH_NO_NETWORK=
MORPH_NO_NATIVE=
# Attach child processes to an existing delegated cgroup (Linux workers).
MORPH_CGROUP_PATH=
